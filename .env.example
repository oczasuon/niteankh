# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

SECRET_KEY=change-me-to-something-random

# Leave unset to use local SQLite. Set to a Postgres URL to use Postgres instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Leave all R2_* unset to use local disk storage for uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=

# Telegram bank-notification verification (wallet top-up)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# Userbot (real account) session, needed because Telegram bots can't see other
# bots' messages and bank notifications are usually posted by a bot. Generate
# these by running: venv\Scripts\python.exe telegram_userbot_login.py
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_STRING=
